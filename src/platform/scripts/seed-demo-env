#!/usr/bin/env bash
# Prepare the demo VM for first deployment.
#
# Usage: scripts/seed-demo-env
#
# Run this once on a fresh VM. It installs Docker, creates the deploy directory,
# and generates a skeleton .env.
set -euo pipefail

DEMO_HOST="${DEMO_HOST:-}"
DEMO_USER="${DEMO_USER:-ubuntu}"
DEMO_PATH="${DEMO_PATH:-/opt/lms}"

if [[ -z "$DEMO_HOST" ]]; then
  echo "ERROR: DEMO_HOST not set."
  exit 1
fi

REMOTE="${DEMO_USER}@${DEMO_HOST}"

echo "=== Seeding demo environment on ${REMOTE} ==="

ssh "$REMOTE" bash <<'REMOTE_SCRIPT'
set -euo pipefail

# Install Docker if missing
if ! command -v docker &>/dev/null; then
  echo "Installing Docker..."
  curl -fsSL https://get.docker.com | sh
  sudo usermod -aG docker $USER
  echo "Docker installed. You may need to log out and back in."
fi

# Install Docker Compose plugin if missing
if ! docker compose version &>/dev/null; then
  echo "Installing Docker Compose plugin..."
  sudo apt-get update && sudo apt-get install -y docker-compose-plugin
fi

# Create deploy directory
sudo mkdir -p /opt/lms
sudo chown $USER:$USER /opt/lms

# Create skeleton .env if it doesn't exist
if [ ! -f /opt/lms/.env ]; then
  cat > /opt/lms/.env <<'ENV'
# Generated by seed-demo-env. Fill in real values.
POSTGRES_USER=lms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lms_db
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
ENV
  echo "Created /opt/lms/.env — edit it with real secrets."
fi

echo "Demo environment ready at /opt/lms"
REMOTE_SCRIPT

echo "=== Seeding complete ==="
