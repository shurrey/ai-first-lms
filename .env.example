# .env.example — copy to .env and fill in secrets
# Never commit .env to the repo.

# --- Postgres ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev
POSTGRES_DB=lms_db
POSTGRES_PORT=5432

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Services (ports) ---
ORCHESTRATOR_PORT=8000
FRONTEND_PORT=3000
GRAFANA_PORT=3001
