# .env.example — copy to .env and fill in secrets
# Never commit .env to the repo.

# --- Postgres ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev
POSTGRES_DB=lms_db
POSTGRES_PORT=5432

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Fish Audio (optional, podcast TTS) ---
FISH_AUDIO_API_KEY=
FISH_AUDIO_HOST_VOICE=e3cd384158934cc9a01029cd7d278634
FISH_AUDIO_EXPERT_VOICE=536d3a5e000945adb7038665781a4aca

# --- Services (ports) ---
ORCHESTRATOR_PORT=8000
FRONTEND_PORT=3000
# Ultra UI host port; the container always listens on 3100
ULTRA_FRONTEND_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# --- Telemetry ---
# Inside compose the orchestrator reaches the collector by service name (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Outbound TLS (see docs/setup.md "Corporate network / TLS inspection") ---
# Host path to a PEM with the corporate TLS-inspection root, baked into the Python images
# at build time. Leave unset off the corporate network. Rebuild after changing it.
# CORPORATE_CA_PATH=./certs/corporate-root.pem
# Disables certificate verification in the shared HTTP client. Logs an ERROR on every boot.
TLS_INSECURE_SKIP_VERIFY=false

# --- Per-turn budget caps (orchestrator) ---
MAX_TOKENS_PER_TURN=250000
MAX_TOOL_CALLS_PER_TURN=40
MAX_WALL_TIME_PER_TURN_MS=120000
MAX_AGENT_INVOCATIONS_PER_TURN=8

# --- MCP servers ---
MCP_CONTENT_PORT=7001
MCP_ROSTER_PORT=7002
MCP_ASSESSMENTS_PORT=7003
MCP_ANALYTICS_PORT=7004
MCP_SIS_PORT=7005
MCP_COMMUNICATIONS_PORT=7006
MCP_STANDARDS_PORT=7007
