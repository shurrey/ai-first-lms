# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Required: Anthropic API key for Claude model calls at runtime
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Postgres (used by docker-compose)
POSTGRES_USER=lms
POSTGRES_PASSWORD=localdev
POSTGRES_DB=aifirst_lms
DATABASE_URL=postgresql://lms:localdev@localhost:5432/aifirst_lms

# Optional: model overrides (defaults are in contracts/agent-manifests.yaml)
# ORCHESTRATOR_MODEL=claude-sonnet-4-6
# DEFAULT_AGENT_MODEL=claude-sonnet-4-6
# FAST_AGENT_MODEL=claude-haiku-4-5-20251001

# Optional: cost guardrails
# MAX_TOKENS_PER_TURN=100000
# MAX_TOOL_CALLS_PER_TURN=25
# MAX_WALL_TIME_PER_TURN_MS=60000

# Optional: observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# GRAFANA_ADMIN_PASSWORD=admin
