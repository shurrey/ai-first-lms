# .env.example — copy to .env and fill in secrets
# Never commit .env to the repo.

# --- Postgres ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev
POSTGRES_DB=lms_db
POSTGRES_PORT=5432

# --- Sign-in (spec §4.3, §4.4) ---
# Password for every seeded account (username = the person's email). Required: db-seed
# refuses to run and `docker compose` refuses to start while it is empty, so choose your
# own value here. scripts/demo and the Playwright login fixture read it from the shell
# environment, so export it first: `set -a; . ./.env; set +a`.
SEED_DEMO_PASSWORD=
# Adds Secure to the lms_session/lms_csrf cookies. Keep false for plain http://localhost,
# where browsers drop Secure cookies.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Consecutive failed logins before the account is locked, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
# Minimum duration of a failed login, so timing does not reveal whether a username exists.
LOGIN_FAILURE_FLOOR_MS=250
# How long an agent's approval_request waits for a decision before the turn gives up.
APPROVAL_TIMEOUT_MINUTES=30

# --- Orchestrator ---
# Serves /docs, /redoc and /openapi.json without sign-in when true. Leave false outside dev.
ENGINE_API_DOCS=false
# Salts the Student-<8 hex> pseudonyms shown to agents. Set any random string per deployment so
# pseudonyms stay the same across restarts; unset, the engine uses a random per-process salt and
# logs a warning.
PII_PSEUDONYM_SALT=

# --- Measurement and scheduled jobs (spec §6) ---
# Days after an AI action during which outcomes count toward its measurement.
MEASURE_WINDOW_DAYS=14
# Runs the in-process scheduler (outcome linker and other periodic jobs). Set false to stop them.
SCHEDULER_ENABLED=true
# How often the outcome linker joins new outcomes to earlier AI actions.
OUTCOME_LINKER_INTERVAL_MINUTES=15

# --- Scenario LLM fixtures ---
# off: call the Anthropic API. record: call it and save each response under LLM_FIXTURE_DIR.
# replay: answer from the saved fixtures and make no API calls.
LLM_FIXTURE_MODE=off
# Path inside the orchestrator container. Required for record and replay; the overlay
# src/platform/llm-fixtures/compose.yaml sets it and mounts the recordings there.
LLM_FIXTURE_DIR=
# Must be 1 for record or replay, confirming this is a test environment; with any other value
# the orchestrator refuses to start in those modes. The fixtures overlay sets it.
LLM_FIXTURE_ALLOW=
# Fixed "now" (ISO date) for the seed, MCP servers and orchestrator in recorded-fixture runs only;
# the overlay defaults it to 2026-10-15. A recording replays only under the value it was made with.
# LMS_AS_OF=2026-10-15

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Fish Audio (optional, podcast TTS) ---
FISH_AUDIO_API_KEY=
FISH_AUDIO_HOST_VOICE=e3cd384158934cc9a01029cd7d278634
FISH_AUDIO_EXPERT_VOICE=536d3a5e000945adb7038665781a4aca

# --- Services (ports) ---
ORCHESTRATOR_PORT=8000
FRONTEND_PORT=3000
# Ultra UI host port; the container always listens on 3100
ULTRA_FRONTEND_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# --- Telemetry ---
# Inside compose the orchestrator reaches the collector by service name (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Outbound TLS (see docs/setup.md "Corporate network / TLS inspection") ---
# Host path to a PEM with the corporate TLS-inspection root, baked into the Python images
# at build time. Leave unset off the corporate network. Rebuild after changing it.
# CORPORATE_CA_PATH=./certs/corporate-root.pem
# Disables certificate verification in the shared HTTP client. Logs an ERROR on every boot.
TLS_INSECURE_SKIP_VERIFY=false

# --- Per-turn budget caps (orchestrator) ---
MAX_TOKENS_PER_TURN=250000
MAX_TOOL_CALLS_PER_TURN=40
MAX_WALL_TIME_PER_TURN_MS=120000
MAX_AGENT_INVOCATIONS_PER_TURN=8

# --- MCP servers ---
MCP_CONTENT_PORT=7001
MCP_ROSTER_PORT=7002
MCP_ASSESSMENTS_PORT=7003
MCP_ANALYTICS_PORT=7004
MCP_SIS_PORT=7005
MCP_COMMUNICATIONS_PORT=7006
MCP_STANDARDS_PORT=7007
